# Medusa Store API
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key is printed at the end of `npm run seed` in /backend,
# or can be created/copied from the Medusa admin (Settings > API Key Management).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Razorpay (stubbed for now — only the public key is needed client-side)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
