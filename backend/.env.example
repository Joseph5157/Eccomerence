# Database & cache
DATABASE_URL=postgres://medusa:medusa@127.0.0.1:5442/medistore
REDIS_URL=redis://localhost:6379

# Secrets — replace with random values in production
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# CORS — origins allowed to call the Store / Admin / Auth APIs
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,http://localhost:8000

# Razorpay (used once a real payment provider is wired up in medusa-config.ts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
